<Project>

  <PropertyGroup>
    <HermesFrontendRoot Condition="'$(HermesFrontendRoot)' == ''">frontend</HermesFrontendRoot>
    <HermesFrontendDist Condition="'$(HermesFrontendDist)' == ''">dist</HermesFrontendDist>
    <HermesFrontendInstallCommand Condition="'$(HermesFrontendInstallCommand)' == ''">npm ci</HermesFrontendInstallCommand>
    <HermesFrontendBuildCommand Condition="'$(HermesFrontendBuildCommand)' == ''">npm run build</HermesFrontendBuildCommand>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(HermesFrontendRoot)/node_modules/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Resolved at execution time, so a project can import this file before setting the properties above. -->
  <Target Name="_HermesFrontendPrepare">
    <PropertyGroup>
      <_HermesFrontendRootDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(HermesFrontendRoot)'))</_HermesFrontendRootDir>
      <_HermesFrontendDistDir>$([MSBuild]::NormalizeDirectory('$(_HermesFrontendRootDir)', '$(HermesFrontendDist)'))</_HermesFrontendDistDir>
      <_HermesFrontendInstallStamp>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'hermes-frontend-install.stamp'))</_HermesFrontendInstallStamp>
      <_HermesFrontendBuildStamp>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'hermes-frontend-build.stamp'))</_HermesFrontendBuildStamp>
      <_HermesFrontendRunCommands>false</_HermesFrontendRunCommands>
      <_HermesFrontendRunCommands Condition="'$(HermesFrontendBuild)' == 'true' OR ('$(HermesFrontendBuild)' == '' AND ('$(Configuration)' == 'Release' OR '$(_IsPublishing)' == 'true'))">true</_HermesFrontendRunCommands>
      <_HermesFrontendRunCommands Condition="'$(DesignTimeBuild)' == 'true' OR '$(NoBuild)' == 'true' OR !Exists('$(_HermesFrontendRootDir)package.json')">false</_HermesFrontendRunCommands>
    </PropertyGroup>

    <!-- Empty inputs make MSBuild skip the install and build targets. -->
    <ItemGroup Condition="'$(_HermesFrontendRunCommands)' == 'true'">
      <_HermesFrontendInstallInput Include="$(_HermesFrontendRootDir)package.json;$(_HermesFrontendRootDir)package-lock.json;$(_HermesFrontendRootDir)npm-shrinkwrap.json;$(_HermesFrontendRootDir)yarn.lock;$(_HermesFrontendRootDir)pnpm-lock.yaml;$(_HermesFrontendRootDir)bun.lock;$(_HermesFrontendRootDir)bun.lockb" />
      <_HermesFrontendInstallInput Remove="@(_HermesFrontendInstallInput)" Condition="!Exists('%(FullPath)')" />
      <_HermesFrontendSource Include="$(_HermesFrontendRootDir)**" Exclude="$(_HermesFrontendRootDir)node_modules/**;$(_HermesFrontendDistDir)**" />
    </ItemGroup>

    <Delete Files="$(_HermesFrontendInstallStamp)" Condition="'$(_HermesFrontendRunCommands)' == 'true' AND !Exists('$(_HermesFrontendRootDir)node_modules')" />
    <Delete Files="$(_HermesFrontendBuildStamp)" Condition="'$(_HermesFrontendRunCommands)' == 'true' AND !Exists('$(_HermesFrontendDistDir)')" />
  </Target>

  <Target Name="HermesInstallFrontend"
          DependsOnTargets="_HermesFrontendPrepare"
          Inputs="@(_HermesFrontendInstallInput)"
          Outputs="$(_HermesFrontendInstallStamp)">
    <Message Importance="high" Text="Hermes: running '$(HermesFrontendInstallCommand)' in $(_HermesFrontendRootDir)" />
    <Exec Command="$(HermesFrontendInstallCommand)" WorkingDirectory="$(_HermesFrontendRootDir)" IgnoreExitCode="true" StandardOutputImportance="high">
      <Output TaskParameter="ExitCode" PropertyName="_HermesFrontendInstallExitCode" />
    </Exec>
    <Error Code="HERMESWEB001"
           Condition="'$(_HermesFrontendInstallExitCode)' != '0'"
           Text="'$(HermesFrontendInstallCommand)' failed with exit code $(_HermesFrontendInstallExitCode) in $(_HermesFrontendRootDir). Fix the error in its output above, or set HermesFrontendBuild=false to skip the frontend build." />
    <Touch Files="$(_HermesFrontendInstallStamp)" AlwaysCreate="true" />
    <ItemGroup>
      <FileWrites Include="$(_HermesFrontendInstallStamp)" />
    </ItemGroup>
  </Target>

  <Target Name="HermesBuildFrontend"
          DependsOnTargets="HermesInstallFrontend"
          Inputs="@(_HermesFrontendSource)"
          Outputs="$(_HermesFrontendBuildStamp)">
    <Message Importance="high" Text="Hermes: running '$(HermesFrontendBuildCommand)' in $(_HermesFrontendRootDir)" />
    <Exec Command="$(HermesFrontendBuildCommand)" WorkingDirectory="$(_HermesFrontendRootDir)" IgnoreExitCode="true" StandardOutputImportance="high">
      <Output TaskParameter="ExitCode" PropertyName="_HermesFrontendBuildExitCode" />
    </Exec>
    <Error Code="HERMESWEB001"
           Condition="'$(_HermesFrontendBuildExitCode)' != '0'"
           Text="'$(HermesFrontendBuildCommand)' failed with exit code $(_HermesFrontendBuildExitCode) in $(_HermesFrontendRootDir). Fix the error in its output above, or set HermesFrontendBuild=false to skip the frontend build." />
    <Touch Files="$(_HermesFrontendBuildStamp)" AlwaysCreate="true" />
    <ItemGroup>
      <FileWrites Include="$(_HermesFrontendBuildStamp)" />
    </ItemGroup>
  </Target>

  <!-- Kept out of single-file bundles, since the static file host reads wwwroot from disk. -->
  <Target Name="HermesCollectFrontend" BeforeTargets="AssignTargetPaths" DependsOnTargets="HermesBuildFrontend">
    <ItemGroup>
      <_HermesFrontendOutput Include="$(_HermesFrontendDistDir)**" />
      <None Include="@(_HermesFrontendOutput)"
            Link="wwwroot/%(_HermesFrontendOutput.RecursiveDir)%(_HermesFrontendOutput.Filename)%(_HermesFrontendOutput.Extension)"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest"
            ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

</Project>
