<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- Library doesn't produce static web assets - apps do -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <!-- Ready-to-Run (R2R) for faster startup -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!-- NuGet Package Metadata -->
  <PropertyGroup>
    <VersionPrefix>1.3.1</VersionPrefix>
    <PackageId>Mythetech.Hermes.Blazor</PackageId>
    <Authors>Mythetech</Authors>
    <Description>Blazor integration for Hermes desktop framework</Description>
    <PackageTags>blazor;desktop;hermes;webview</PackageTags>
    <PackageProjectUrl>https://github.com/Mythetech/Hermes</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Mythetech/Hermes.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Include LICENSE and README in NuGet package -->
  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\Hermes\Hermes.csproj" />
  </ItemGroup>

  <!-- Allow benchmarks to access internal members -->
  <ItemGroup>
    <InternalsVisibleTo Include="Hermes.Benchmarks" />
    <InternalsVisibleTo Include="Hermes.Tests" />
  </ItemGroup>

  <!-- MSBuild targets for static web asset handling (auto-imported by consuming projects) -->
  <ItemGroup>
    <None Include="build/Hermes.Blazor.targets" Pack="true" PackagePath="buildTransitive/net11.0/Mythetech.Hermes.Blazor.targets" />
    <None Include="build/Hermes.Blazor.targets" Pack="true" PackagePath="build/net11.0/Mythetech.Hermes.Blazor.targets" />
  </ItemGroup>

  <!-- The FrameworkReference below puts consuming apps on the Microsoft.AspNetCore.App shared
       framework, which supplies the Components.Web runtime, so the WebView package (and the
       blazor.webview.js it embeds) must track the same .NET 11 build. A 10.x package runs its
       old script against the 11 runtime and every new interop entry point, Virtualize's
       setAnchorMode for one, fails at first render. NU5104 is relaxed only until the 11.0.0
       GA package replaces the RC build. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView" Version="11.0.0-rc.1.26425.128" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
