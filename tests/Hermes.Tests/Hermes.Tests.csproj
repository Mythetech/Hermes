<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.11.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hermes\Hermes.csproj" />
    <ProjectReference Include="..\..\src\Hermes.Testing\Hermes.Testing.csproj" />
    <ProjectReference Include="..\..\src\Hermes.Blazor\Hermes.Blazor.csproj" />
    <ProjectReference Include="..\..\src\Hermes.Web\Hermes.Web.csproj" />
  </ItemGroup>

  <!-- Build-order only: BenchmarkAppEntryPointTests reads these apps' compiled
       entry points from PE metadata, so building the tests must build the apps.
       No assembly reference is taken; their dependencies stay out of the tests.
       The apps target one framework while the tests run on several, so the
       framework compatibility check is skipped and the test's own TargetFramework
       is not passed down; each app is built once, as the solution builds it. -->
  <ItemGroup>
    <ProjectReference Include="..\..\benchmarks\Hermes.Benchmarks.Apps\HermesTestApp\HermesTestApp.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="TargetFramework" />
    <ProjectReference Include="..\..\benchmarks\Hermes.Benchmarks.Apps\PhotinoTestApp\PhotinoTestApp.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="TargetFramework" />
    <ProjectReference Include="..\..\benchmarks\Hermes.Benchmarks.Apps\PhotinoXTestApp\PhotinoXTestApp.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="TargetFramework" />
  </ItemGroup>

</Project>
