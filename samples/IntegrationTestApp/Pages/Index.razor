@page "/"
@inject TestContext Context
@inject VirtualizeProbe Probe

<FluentStack Orientation="Orientation.Vertical" VerticalGap="20">
    <FluentCard>
        <h1>Hermes Integration Tests</h1>
        <p>This application tests various Hermes features including:</p>
        <ul>
            <li><strong>JS Module Loading</strong> - Fluent UI Blazor components</li>
            <li><strong>Custom Titlebar</strong> - Drag regions and window controls</li>
            <li><strong>Native Menus</strong> - Menu creation and accelerators</li>
            <li><strong>Window Management</strong> - Size, position, maximize/restore</li>
            <li><strong>Virtualize Interop</strong> - Framework JS entry points used by Blazor components</li>
        </ul>
    </FluentCard>

    <FluentCard>
        <h2>Test Status</h2>
        @if (Context.IsIntegrationTest)
        {
            <FluentBadge Appearance="Appearance.Accent">Integration Test Mode</FluentBadge>
            @if (Context.AutoExit)
            {
                <FluentBadge>Auto Exit Enabled</FluentBadge>
            }
        }
        else
        {
            <FluentBadge>Manual Mode</FluentBadge>
            <p>Set <code>HERMES_INTEGRATION_TEST=1</code> to enable automated tests.</p>
        }
    </FluentCard>

    <FluentCard>
        <h2>First Render</h2>
        @if (_firstRenderReported)
        {
            <p>First render completed successfully.</p>
            <FluentBadge Appearance="Appearance.Accent">@($"{_renderTime.TotalMilliseconds:F1}ms")</FluentBadge>
        }
        else
        {
            <FluentProgressRing />
        }
    </FluentCard>

    <FluentCard>
        <h2>Virtualize</h2>
        <p>
            Virtualize drives <code>Blazor._internal.Virtualize</code> in <code>blazor.webview.js</code>.
            A script older than the shared framework's Components.Web fails here at first render,
            which is how the .NET 11 RC1 <code>setAnchorMode</code> break surfaced.
        </p>
        <VirtualizeErrorBoundary>
            <ChildContent>
                <div class="virtualize-viewport">
                    <Virtualize ItemsProvider="@LoadRowsAsync" ItemSize="24" Context="row">
                        <div class="virtualize-row">@row</div>
                    </Virtualize>
                </div>
            </ChildContent>
            <ErrorContent Context="ex">
                <FluentBadge Appearance="Appearance.Accent">Virtualize failed: @ex.Message</FluentBadge>
            </ErrorContent>
        </VirtualizeErrorBoundary>
    </FluentCard>
</FluentStack>

@code {
    private static readonly string[] Rows =
        Enumerable.Range(0, 1000).Select(i => $"Virtualized row {i}").ToArray();

    private TimeSpan _renderTime;
    private bool _firstRenderReported;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _renderTime = TimeSpan.FromMilliseconds(100); // Placeholder
            _firstRenderReported = true;

            // Report JS module loading test (Fluent UI uses JS interop)
            TestReporter.Start("blazor-first-render");
            TestReporter.Pass("blazor-first-render");

            StateHasChanged();
        }
    }

    private ValueTask<ItemsProviderResult<string>> LoadRowsAsync(ItemsProviderRequest request)
    {
        // Virtualize renders with a visible item capacity of zero until the JS spacer callback
        // reports the container size, so a non-empty request proves the interop round trip closed.
        if (request.Count > 0)
        {
            Probe.ReportInteropCompleted();
        }

        var start = Math.Min(request.StartIndex, Rows.Length);
        var count = Math.Min(request.Count, Rows.Length - start);

        return ValueTask.FromResult(
            new ItemsProviderResult<string>(Rows.Skip(start).Take(count), Rows.Length));
    }
}
